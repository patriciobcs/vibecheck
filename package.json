{
  "name": "vibecheck",
  "private": true,
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @vibecheck/web dev",
    "worker": "pnpm --filter @vibecheck/web worker",
    "build": "pnpm -r build",
    "check": "biome check . && pnpm -r typecheck",
    "check:fix": "biome check --write .",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @vibecheck/web test:e2e",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:generate": "pnpm --filter @vibecheck/web db:generate",
    "db:migrate": "pnpm --filter @vibecheck/web db:migrate",
    "db:seed": "pnpm --filter @vibecheck/web db:seed",
    "db:reset-sample": "pnpm --filter @vibecheck/web db:reset-sample",
    "tunnel": "pnpm --filter @vibecheck/web tunnel"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "typescript": "^5.9.3"
  }
}
