generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProductStatus {
  draft
  connecting
  ready
  needs_setup
}

enum DiscoveryStatus {
  queued
  inspecting
  proposed
  failed
  cancelled
}

enum DiscoveryProvider {
  fixture
  devin
}

enum DiscoveryOutcome {
  proposed
  cannot_assess
  needs_setup
}

enum StudyStatus {
  draft
  published
  recruiting
}

enum JobStatus {
  pending
  running
  done
  failed
}

model Tenant {
  id              String           @id @default(cuid())
  name            String
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  apiKeys         ApiKey[]
  products        Product[]
  runs            DiscoveryRun[]
  studies         Study[]
  jobs            Job[]
  publishRequests PublishRequest[]
}

model ApiKey {
  id        String   @id @default(cuid())
  tenantId  String
  keyHash   String   @unique
  label     String
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Product {
  id                String         @id @default(cuid())
  tenantId          String
  name              String
  description       String
  url               String
  permittedOrigins  String[]
  language          String
  audience          String
  repoBinding       Json?
  releaseNotes      Json
  supportComplaints Json
  knownJourneys     Json
  productEvents     Json
  status            ProductStatus
  setupError        String?
  tenant            Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  discoveryRuns     DiscoveryRun[]
  studies           Study[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model DiscoveryRun {
  id                 String          @id @default(cuid())
  productId          String
  tenantId           String
  status             DiscoveryStatus
  provider           DiscoveryProvider
  providerSessionId  String?
  providerSessionUrl String?
  sourceRevision     String
  outcome            DiscoveryOutcome?
  outcomeReason      String?
  rawResponses       Json
  correctionAttempts Int             @default(0)
  error              String?
  product            Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant             Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  proposals          Proposal[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([tenantId])
}

model Proposal {
  id                       String       @id @default(cuid())
  discoveryRunId           String
  tenantId                 String
  taskId                   String
  researchQuestion         String
  participantPrompt        String
  rationale                String
  evidenceRefs             String[]
  evidenceType             String
  eligibilityRuleRef       String
  successRuleRef           String
  uncertainties            String[]
  estimatedDurationSeconds Int?
  confidence               String?
  discoveryRun             DiscoveryRun @relation(fields: [discoveryRunId], references: [id], onDelete: Cascade)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  @@unique([discoveryRunId, taskId])
}

model Study {
  id              String              @id @default(cuid())
  productId       String
  tenantId        String
  status          StudyStatus
  currentRevision Int
  product         Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenant          Tenant              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  revisions       StudyPlanRevision[]
  publishRequests PublishRequest[]
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
}

model StudyPlanRevision {
  id          String    @id @default(cuid())
  studyId     String
  revision    Int
  plan        Json
  publishedAt DateTime?
  study       Study     @relation(fields: [studyId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([studyId, revision])
}

model OutboxEvent {
  idempotencyKey String    @id
  eventId        String    @unique
  eventType      String
  tenantId       String
  productId      String
  correlationId  String
  payload        Json
  occurredAt     DateTime
  publishedAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

model PublishRequest {
  id             String   @id @default(cuid())
  tenantId       String
  idempotencyKey String
  studyId        String
  responseHash   String
  tenant         Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  study          Study    @relation(fields: [studyId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([tenantId, idempotencyKey])
}

model Job {
  id          String    @id @default(cuid())
  type        String
  tenantId    String
  payload     Json
  status      JobStatus @default(pending)
  attempts    Int       @default(0)
  maxAttempts Int       @default(3)
  leaseUntil  DateTime?
  lockedBy    String?
  nextRunAt   DateTime  @default(now())
  lastError   String?
  tenant      Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, nextRunAt])
}
