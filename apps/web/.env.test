# Overrides for automated tests (loaded after .env.local). Vitest integration tests use a
# separate database so they never wipe development data.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54332/vibecheck_test
NEXT_PUBLIC_APP_URL=http://localhost:3100
BETTER_AUTH_URL=http://localhost:3100
# Dummy, non-secret values so the suite starts from a clean checkout. Nothing here talks to
# Supabase or sends mail; providers stay unconfigured (tests inject fakes).
SUPABASE_URL=http://127.0.0.1:54331
SUPABASE_SERVICE_ROLE_KEY=test-service-role-key
BETTER_AUTH_SECRET=test-only-better-auth-secret-at-least-32-chars
