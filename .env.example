# Seamless UX — copy to .env.local (apps/web reads it; the worker reads the same file).
# Never commit .env.local. Secrets stay server-side; only NEXT_PUBLIC_* reach browsers.

# ---- App -------------------------------------------------------------------
# Public origin of the web app. Used for magic links, SDK origin checks and webhooks.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Publicly reachable origin for provider webhooks (Vonage archive callback).
# `pnpm tunnel` fills this with a cloudflared quick-tunnel URL (changes on every restart).
PUBLIC_WEBHOOK_BASE_URL=http://localhost:3000
# Optional stable alternative: a named cloudflared tunnel on your own domain.
#   cloudflared tunnel login && cloudflared tunnel create vibecheck-dev
#   cloudflared tunnel route dns vibecheck-dev vibecheck-dev.yourdomain.com
# then set both values; `pnpm tunnel` runs the named tunnel and the URL never changes.
# CLOUDFLARE_TUNNEL_NAME=vibecheck-dev
# PUBLIC_WEBHOOK_BASE_URL=https://vibecheck-dev.yourdomain.com

# ---- Database (local Supabase: `pnpm db:start`) ----------------------------
# `supabase start` prints these. Defaults below match the Supabase CLI defaults.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54332/postgres
SUPABASE_URL=http://127.0.0.1:54331
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_supabase_start_service_role_key
# Private bucket for session media. Created by `pnpm db:seed` if missing.
SUPABASE_STORAGE_BUCKET=session-media

# ---- Auth (Better Auth, magic link) ----------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=REPLACE_WITH_openssl_rand_base64_32
BETTER_AUTH_URL=http://localhost:3000
# test_inbox: magic links are written to the database and shown at /dev/inbox (no email sent).
EMAIL_MODE=test_inbox

# ---- Vonage Video API (screen + microphone recording) ----------------------
# Vonage dashboard → Applications → your app (Video capability enabled).
VONAGE_APPLICATION_ID=REPLACE_WITH_application_id
# Either a path to the downloaded private.key ...
VONAGE_PRIVATE_KEY_PATH=./private.key
# ... or the key itself, base64-encoded (takes precedence if set):
# VONAGE_PRIVATE_KEY_BASE64=
# Archive status callback: `pnpm tunnel` starts a cloudflared quick tunnel, writes
# PUBLIC_WEBHOOK_BASE_URL and (with the account API key/secret below) points the app's
# Video "Archive status" webhook at ${PUBLIC_WEBHOOK_BASE_URL}/api/webhooks/vonage/archive.
# The signature secret cannot be set by API: enable it once in the dashboard
# (Applications → your app → Video → Archive status → signature secret) and paste it here.
VONAGE_ARCHIVE_SIGNATURE_SECRET=REPLACE_WITH_signature_secret
# Account-level API key and secret (dashboard home page). Only used by `pnpm tunnel` to
# update the callback address; never sent to browsers.
VONAGE_API_KEY=REPLACE_WITH_account_api_key
VONAGE_API_SECRET=REPLACE_WITH_account_api_secret
# Optional: Vonage Video region hint for sessions (leave blank for default).
VONAGE_SESSION_LOCATION=

# ---- SLNG (speech-to-text gateway) -----------------------------------------
# Dashboard → Projects → API keys. Sent as "Authorization: Bearer".
SLNG_API_KEY=REPLACE_WITH_slng_api_key
# Regional base URL, e.g. https://eu-west.slng.ai or https://api.slng.ai
SLNG_BASE_URL=https://api.slng.ai
# STT model path appended to SLNG_BASE_URL. Default: SLNG-hosted Deepgram Nova 3 (English).
SLNG_STT_PATH=/v1/stt/slng/deepgram/nova:3-en
SLNG_STT_LANGUAGE=en

# ---- Worker ----------------------------------------------------------------
WORKER_POLL_INTERVAL_MS=2000
WORKER_LEASE_SECONDS=60

# ---- Sample data -----------------------------------------------------------
# `pnpm db:seed` creates one tenant, product and published study from a labeled
# sample StudyPlan (VC-01 output is not implemented yet). This is the dev owner login.
SEED_OWNER_EMAIL=owner@example.test

# ---- Discovery (VC-01) -----------------------------------------------------
# fixture: labeled sample proposals for local dev/tests. devin: real Devin analysis session.
DISCOVERY_PROVIDER=fixture
# Evidence analysis provider; defaults to DISCOVERY_PROVIDER when unset.
ANALYSIS_PROVIDER=fixture
# Repair orchestration adapters; fixture keeps local runs deterministic.
REPAIR_PROVIDER=fixture
VALIDATOR=fixture
PREVIEW_PROVIDER=fixture
# Vercel resolves GitHub integration deployments by candidate commit SHA; Seamless UX does not trigger builds.
VERCEL_TOKEN=REPLACE_WITH_vercel_token
VERCEL_PROJECT_ID=REPLACE_WITH_vercel_project_id
VERCEL_TEAM_ID=
VERCEL_API_BASE=https://api.vercel.com
VERCEL_DEPLOY_TIMEOUT_MS=900000
VERCEL_POLL_MS=10000
# Experiment summary narrative provider.
SUMMARY_PROVIDER=fixture
DEVIN_API_KEY=REPLACE_WITH_devin_api_key
DEVIN_API_BASE=https://api.devin.ai/v1
DEVIN_MAX_ACU=5
# Accept loopback product URLs (development only; a remote agent cannot reach them anyway).
ALLOW_LOCAL_TARGETS=true
# Programmatic API key seeded by `pnpm db:seed` for the sample tenant (Authorization: Bearer).
DEV_API_KEY=dev_local_key_1

# ---- Evidence analysis and issue publication (VC-03) -----------------------
# GitHub App credentials publish issues as the installed app bot. The private key may be
# supplied as PEM text; escaped \n newlines and bare base64 PKCS#1 bodies are accepted.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Development/test fallback only; leave unset when exercising GitHub App authentication.
GITHUB_ISSUES_TOKEN=
# The dashboard link is included in public issues only when this is a public URL.
APP_BASE_URL=
ISSUE_PUBLISHER=github

# ---- Jev screening (typesafe.ai) -------------------------------------------
# Screens bounded telemetry windows for possible friction. Never creates issues or repairs by itself.
JEV_API_KEY=REPLACE_WITH_jev_api_key
JEV_BASE_URL=https://api.typesafe.ai
JEV_MODEL=jev-latest
# Optional pricing so the daily spend cap can be enforced; leave unset to report costs as unpriced.
# JEV_PRICE_PER_1K_INPUT_USD=
# JEV_PRICE_PER_1K_OUTPUT_USD=

# Demo mode (local only): hides developer copy and adds a one-click "Enter the demo" sign-in for
# SEED_OWNER_EMAIL. Ignored when NODE_ENV=production.
DEMO_MODE=false

# Public demo identities (used by "Enter as …" when DEMO_MODE=true). Both are seeded by `pnpm db:seed`.
DEMO_TESTER_EMAIL=tester@example.test
# Instrumented Excalidraw clone (seeded as the demo product URL and permitted origin).
EXCALIDRAW_DEMO_URL=http://localhost:3200/

# Serverless deployments (Vercel): no worker process. Run jobs inline after requests and expose
# /api/internal/drain for a cron with this bearer secret. Leave both unset when `pnpm worker` runs.
INLINE_JOBS=false
CRON_SECRET=REPLACE_WITH_random_secret
